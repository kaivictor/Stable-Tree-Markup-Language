# 系统配置
"app":
  "name": "MyApp"
  "version": "2.1.0"
  "description": {
    这是一个多行字符串。
    它包含换行符和特殊字符如引号"和斜杠\。
    还有Unicode: 你好世界。
  }
  "license": "MIT"
  "author": "John Doe"

# 数据库配置
"database":
  "host": "localhost"
  "port": "5432"
  "credentials":
    "username": "admin"
    "password": "secret123"
  "pool_size": "10"
  "timeout": "30.5"
  "options":
    "ssl": "true"
    "max_connections": "100"
    "application_name": "MyApp"

# 缓存配置
"cache":
  "type": "redis"
  "servers":
    - "host": "redis1.example.com"
      "port": "6379"
    - "host": "redis2.example.com"
      "port": "6379"
  "default_ttl": "3600"

# 日志配置
"logging":
  "level": "INFO"
  "handlers":
    - "type": "console"
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    - "type": "file"
      "filename": "/var/log/myapp.log"
      "max_bytes": "10485760"
      "backup_count": "5"
  "root_logger":
    "level": "DEBUG"
    "handlers": ["console", "file"]

# 安全配置
"security":
  "jwt_secret": "my-secret-key"
  "allowed_origins":
    - "http://localhost:3000"
    - "https://example.com"
  "rate_limit":
    "enabled": "true"
    "requests_per_minute": "100"

# 功能开关
"features":
  - "name": "dark_mode"
    "enabled": "true"
  - "name": "notifications"
    "enabled": "false"
  - "name": "export"
    "enabled": "true"
    "options":
      "formats": ["csv", "json", "xlsx"]

# 用户列表
"users":
