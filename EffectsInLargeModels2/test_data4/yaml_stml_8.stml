# 一些额外的设置
"settings":
  # 10 MB in bytes
  "max_upload_size": "10485760"
  "allowed_file_types":
    - ".jpg"
    - ".png"
    - ".pdf"
    - ".docx"
  "email":
    "smtp_host": "smtp.example.com"
    "smtp_port": "587"
    "use_tls": "true"
    "from_address": "no-reply@example.com"
  "notifications":
    "enabled": "true"
    "channels":
      - "email"
      - "sms"
      - "push"