"注释示例": {
  # 这是一个注释，不会出现在JSON中
  "实际键": "实际值"
  # 注释可以出现在任何地方，但必须单独一行
}
"多行文本示例": {
这是第一行
这是第二行
  这是有缩进的第三行
最后一行
}
"行内列表示例": ["元素1", "元素2", "元素3"]
"多行列表示例":
  - "列表项A"
  - "列表项B"
  - "列表项C"
"嵌套字典示例": {
  "第一层": {
    "第二层": {
      "第三层": "深层值"
    }
  }
}
"空值示例": null
"混合示例": {
  "字符串": "hello",
  "列表": ["a", "b"],
  "字典": {
    "子键": "子值"
  }
}
---
"第二个文档": "这是多文档示例"
"内容": {
  "文档编号": 2,
  "描述": "STML支持使用---分隔多个文档"
}
"列表嵌套字典": [
  {
    "姓名": "张三",
    "年龄": 30,
    "爱好": ["阅读", "编程"]
  },
  {
    "姓名": "李四",
    "年龄": 25,
    "爱好": ["音乐", "运动"]
  }
]
"多行文本带引号": {
他说："你好，世界！"
换行符：\n
双引号："
}
"特殊字符转义": "包含\"双引号\"和\\反斜杠以及\n换行"
"最后一个键": "结束"