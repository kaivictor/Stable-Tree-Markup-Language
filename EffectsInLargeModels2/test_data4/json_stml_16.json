  "security": {
    "jwt_secret": "my_super_secret_key_12345",
    "token_expiry": 3600,
    "allowed_origins": [
      "https://app.example.com",
      "https://admin.example.com"
    ],
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 100,
      "burst": 200
    }
  },
  "cache": {
    "redis": {
      "host": "redis.example.com",
      "port": 6379,
      "db": 0,
      "password": "redis_secret",
      "timeout": 5
    },
    "memcached": {
      "hosts": [
        "memcached1.example.com:11211",
        "memcached2.example.com:11211"
      ],
      "timeout": 2
    }
  },
  "task_queue": {
    "celery": {
      "broker_url": "redis://redis.example.com:6379/1",
      "result_backend": "redis://redis.example.com:6379/2",
      "task_serializer": "json",
      "result_serializer": "json",
      "accept_content": ["json"],
      "timezone": "UTC",
      "enable_utc": true
    },
    "rabbitmq": {
      "host": "rabbitmq.example.com",
      "port": 5672,
      "vhost": "/",
      "username": "guest",
      "password": "guest"
    }
  },
  "third_party_apis": {
