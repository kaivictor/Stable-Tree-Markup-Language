  "global": {
    "app_name": "MyApp",
    "version": "2.0.1",
    "debug": false,
    "environment": "production",
    "description": "This is a long description that spans multiple lines.\nIt can contain many characters to make the YAML rich.\nWe can add more lines here to increase length.\n",
    "large_list": [
      "item_000",
      "item_001",
      "item_002",
      "item_003",
      "item_004",
      "item_005",
      "item_006",
      "item_007",
      "item_008",
      "item_009"
    ]
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "workers": 4,
    "ssl": {
      "enabled": true,
      "cert_file": "/etc/ssl/certs/server.crt",
      "key_file": "/etc/ssl/private/server.key"
    },
    "allowed_hosts": [
      "example.com",
      "*.example.com",
      "localhost"
    ],
    "extra_list": [
      "item_000",
      "item_001",
      "item_002",
      "item_003",
      "item_004",
      "item_005",
      "item_006",
      "item_007",
      "item_008",
      "item_009"
    ]
  },
  "db_template": {
    "type": "postgresql",
    "host": "localhost",
    "port": 5432,
    "username": "admin",
    "password": "secret",
    "pool_size": 10,
    "options": {
      "sslmode": "require",
      "connect_timeout": 30
    }
  },
  "databases": {
    "primary": {
      "type": "postgresql",
      "host": "localhost",
      "port": 5432,
      "username": "admin",
      "password": "secret",
      "pool_size": 10,
      "options": {
        "sslmode": "require",
        "connect_timeout": 30
      },
      "database": "primary_db"
    },
    "replica": {
      "type": "postgresql",
      "host": "replica.example.com",
      "port": 5432,
      "username": "admin",
      "password": "secret",
      "pool_size": 10,
      "options": {
        "sslmode": "require",
        "connect_timeout": 30
      },
      "database": "replica_db"
    },
    "cache": {
      "type": "redis",
      "host": "redis.example.com",
      "port": 6379,
      "username": "admin",
      "password": "redis_secret",
      "pool_size": 10,
      "options": {
        "sslmode": "require",
        "connect_timeout": 30
      },
      "database": 0
    }
  },
  "logging": {
    "level": "INFO",
    "handlers": [
      {
        "type": "console",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
      },
      {
        "type": "file",
        "filename": "/var/log/myapp/app.log",
        "max_bytes": 10485760,
        "backup_count": 5
      }
    ],
    "root_logger": {
      "level": "WARNING"
    }
  },
  "user_template": {
    "enabled": true,
    "roles": ["user"],
    "permissions": ["read", "write"],
    "metadata": {
      "created_at": "2023-01-01T00:00:00Z",
      "last_login": "2023-06-15T12:30:00Z",
      "notes": "Standard user account."
    }
  },
