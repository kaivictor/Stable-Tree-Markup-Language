# System Settings
"system_name":"Library Management System"
"version":"2.1.0"
"database":
  "host":"localhost"
  "port":"5432"
  "name":"library_db"
  "credentials":
    "username":"admin"
    "password":"secret"
"features":
  "self_checkout":"true"
  "online_catalog":"true"
  "interlibrary_loan":"false"
"maintenance_schedule":{
Weekly backups on Sunday at 2:00 AM.
Monthly system updates on the first Saturday.
Quarterly hardware inspections.
Annual software upgrades.
}
"notes":"This system is designed to handle up to 100,000 patrons."