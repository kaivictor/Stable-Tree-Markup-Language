{
  "app": {
    "name": "MyApp",
    "version": "2.1.0",
    "description": "This is a multi-line description.\nIt can have multiple lines.\nAnd it's preserved in YAML.\n",
    "features": {
      "enable_feature_a": true,
      "enable_feature_b": false,
      "enable_feature_c": null
    }
  },
  "database": {
    "primary": {
      "host": "db1.example.com",
      "port": 5432,
      "username": "admin",
      "password": "secret123",
      "pool": {
        "min": 5,
        "max": 20,
        "timeout": 30.5
      },
      "options": [
        {"ssl": true},
        {"connect_timeout": 10}
      ]
    },
    "replica": [
      {"host": "db2.example.com", "port": 5432},
      {"host": "db3.example.com", "port": 5432}
    ]
  },
  "server": {
    "listen": "0.0.0.0",
    "port": 8080,
    "ssl": {
      "enabled": true,
      "cert": "/etc/ssl/certs/server.crt",
      "key": "/etc/ssl/private/server.key"
    },
    "cors": {
      "allowed_origins": [
        "https://example.com",
        "https://app.example.com"
      ],
      "methods": ["GET", "POST", "PUT", "DELETE"]
    }
  },
  "logging": {
    "level": "info",
    "file": "/var/log/myapp/app.log",
    "format": "json",
    "rotation": {
      "max_size": "100MB",
      "max_files": 10
    }
  },
