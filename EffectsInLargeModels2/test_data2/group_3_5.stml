# 这是一个非常复杂的STML文档，包含多种结构
"文档标题": "复杂STML示例"
"版本": "2.0.0"
"创建日期": "2025-03-20"
"作者": "AI助手"
"描述": {
这是一个多行文本描述。
它包含多行内容，并且有缩进。
  第一行前面有两个空格。
  第二行也有两个空格。
第三行没有缩进。
最后一行。
}
"标签": ["STML", "复杂", "示例", "多文档"]
"功能列表":
  - "解析STML"
  - "生成YAML"
  - "支持多文档"
  - "嵌套结构"
  - "多行文本"
"配置":
  "编码": "UTF-8"
  "缩进": 2
  "严格模式": "true"
  "最大深度": "10"
  "允许注释": "true"
  "多行支持": "true"
  "嵌套配置":
    "子配置1": "值1"
    "子配置2": "值2"
    "子配置3":
      "深层配置": "深层值"
      "另一个深层": "另一个值"
"数据列表":
  - "名称": "数据1"
    "值": "100"
    "描述": "第一个数据"
    "属性":
      "类型": "整数"
      "单位": "无"
  - "名称": "数据2"
    "值": "200"
    "描述": null
    "属性":
      "类型": "浮点数"
      "单位": "米"
  - "名称": "数据3"
    "值": "300"
    "描述": "第三个数据"
    "属性": null
"空值测试":
  "空字符串": ""
  "null值": null
  "空列表": []
  "空字典": {}
"多行列表测试":
  - "第一项"
  - "第二项"
  - "第三项"
  - "第四项"
"嵌套列表测试":
  - ["子项1", "子项2"]
  - ["子项3", "子项4"]
  - ["子项5", "子项6", "子项7"]
"复杂嵌套":
  "层级1":
    "层级2":
      "层级3": "最终值"
      "另一个层级3": "另一个值"
    "层级2-2": "值"
  "层级1-2": "值"
  "层级1-3":
    "层级2-3":
      "层级3-3": "更深的值"
"长文本测试": {
这是一段非常长的多行文本，用于测试STML的多行文本支持。
它可以包含任意字符，包括引号"和换行符。
注意：引号需要转义，但这里我们避免使用引号。
实际上，我们可以包含很多行，以增加总字符数。
比如这一行是第5行。
第6行。
第7行。
第8行。
第9行。
第10行。
}
"行内列表测试": ["这是一个", "行内列表", "包含多个元素", "每个元素都是字符串"]
"混合列表测试":
  - "字符串项"
  - "另一个字符串"
  - "第三个字符串"
"字典列表测试":
  - "键1": "值1"
    "键2": "值2"
  - "键1": "值3"
    "键2": "值4"
  - "键1": "值5"
    "键2": "值6"
"注释测试": "这行后面没有注释"
# 这是一行注释
"下一行": "继续"
# 另一行注释
"最后一行": "结束"
---
# 第二个文档
"文档2标题": "第二个文档"
"内容": {
这是第二个文档的多行文本。
它也有多行。
并且包含一些特殊字符：\n和\t。
但这里我们直接写文本。
}
"列表":
  - "项1"
  - "项2"
  - "项3"
"字典":
  "键1": "值1"
  "键2": "值2"
  "键3": "值3"
"混合测试":
  "子字典":
    "子键": "子值"
    "子键2": "子值2"
  "子列表": ["a", "b", "c"]
"嵌套字典列表":
  - "名称": "对象1"
    "属性":
      "颜色": "红色"
      "大小": "大"
  - "名称": "对象2"
    "属性":
      "颜色": "蓝色"
      "大小": "小"
"多行列表":
  - "第一行"
  - "第二行"
  - "第三行"
"空值测试2":
  "空字符串": ""
  "null值": null
"结束标记": "文档结束"