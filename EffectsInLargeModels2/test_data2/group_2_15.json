{
  "system": {
    "name": "Galactic Nexus",
    "version": 3.14159,
    "release_date": "2025-04-01",
    "active": true,
    "debug": false,
    "null_value": null,
    "description": "这是一个多行字符串。\n它包含换行符和缩进。\n最后一行没有换行符。\n",
    "tags": ["production", "stable", "v3"],
    "components": [
      {
        "name": "Core Engine",
        "type": "service",
        "port": 8080,
        "endpoints": ["/api/v1/status", "/api/v1/health", "/api/v1/metrics"],
        "config": {
          "max_connections": 1000,
          "timeout": 30.5,
          "retry_policy": {
            "max_retries": 3,
            "backoff": "exponential",
            "jitter": true
          }
        }
      },
      {
        "name": "Data Pipeline",
        "type": "batch",
        "schedule": "0 0 * * *",
        "input": {
          "source": "s3://bucket/input/",
          "format": "parquet",
          "options": {
            "compression": "snappy",
            "infer_schema": true
          }
        },
        "output": {
          "destination": "hdfs://namenode:9000/output/",
          "format": "orc",
          "partition_by": ["date", "hour"]
        },
        "transforms": [
          {
            "type": "filter",
            "condition": "age > 18"
          },
          {
            "type": "map",
            "expression": "upper(name)"
          },
          {
            "type": "aggregate",
            "group_by": ["country"],
            "metrics": ["sum(salary)", "avg(age)"]
          }
        ]
      }
    ],
    "users": [
      {
        "id": 1001,
        "name": "Alice Johnson",
        "roles": ["admin", "developer"],
        "permissions": {
          "read": true,
          "write": true,
          "delete": false
        },
        "metadata": {
          "created_at": "2024-01-15T10:30:00Z",
          "last_login": "2025-03-20T08:45:12Z",
          "preferences": {
            "theme": "dark",
            "language": "en-US",
            "notifications": {
              "email": true,
              "sms": false,
              "push": true
            }
          }
        }
      },
      {
        "id": 1002,
        "name": "Bob Smith",
        "roles": ["viewer"],
        "permissions": {
          "read": true,
          "write": false,
          "delete": false
        },
        "metadata": {
          "created_at": "2024-06-22T14:00:00Z",
          "last_login": "2025-04-01T12:00:00Z",
          "preferences": {
            "theme": "light",
            "language": "fr-FR",
            "notifications": {
              "email": false,
              "sms": false,
              "push": false
            }
          }
        }
      },
      {
        "id": 1003,
        "name": "Charlie Brown",
        "roles": ["editor", "moderator"],
        "permissions": {
          "read": true,
          "write": true,
          "delete": true
        },
        "metadata": {
          "created_at": "2024-11-01T09:15:00Z",
          "last_login": null,
          "preferences": {
            "theme": "system",
            "language": "de-DE",
            "notifications": {
              "email": true,
              "sms": true,
              "push": false
            }
          }
        }
      }
    ],
    "database": {
      "type": "postgresql",
      "host": "db.internal",
      "port": 5432,
      "database": "galaxy_nexus",
      "pool": {
        "min_size": 5,
        "max_size": 20,
        "idle_timeout": 300
      },
      "ssl": {
        "enabled": true,
        "ca_cert": "/etc/ssl/certs/ca.pem",
        "client_cert": "/etc/ssl/certs/client.pem",
        "client_key": "/etc/ssl/private/client.key"
      }
    },
    "logging": {
      "level": "INFO",
      "format": "json",
      "outputs": [
        {
          "type": "file",
          "path": "/var/log/system.log",
          "rotation": {
            "max_size": "100MB",
            "max_files": 10
          }
        },
        {
          "type": "syslog",
          "host": "logs.example.com",
          "port": 514,
          "protocol": "udp"
        },
        {
          "type": "elasticsearch",
          "hosts": [
            "https://es1.example.com:9200",
            "https://es2.example.com:9200"
          ],
          "index": "system-logs-{now/d}",
          "batch_size": 500
        }
      ]
    },
    "monitoring": {
      "metrics": {
        "enabled": true,
        "port": 9090,
        "path": "/metrics"
      },
      "alerts": [
        {
          "name": "High CPU",
          "condition": "cpu_usage > 90",
          "severity": "critical",
          "actions": [
            {
              "type": "email",
              "to": ["ops@example.com", "admin@example.com"]
            },
            {
              "type": "webhook",
              "url": "https://hooks.example.com/alerts"
            }
          ]
        },
        {
          "name": "Low Disk Space",
          "condition": "disk_free < 10GB",
          "severity": "warning",
          "actions": [
            {
              "type": "email",
              "to": ["ops@example.com"]
            }
          ]
        }
      ]
    },
    "features": [
      {
        "name": "AI Assistant",
        "enabled": true,
        "model": "gpt-4",
        "parameters": {
          "temperature": 0.7,
          "max_tokens": 2048,
          "top_p": 0.9
        }
      },
      {
        "name": "Real-time Sync",
        "enabled": false,
        "reason": "Under maintenance"
      }
    ],
    "nested_example": {
      "level1": {
        "level2": {
          "level3": {
            "level4": {
              "value": "deeply nested",
              "numbers": [1, 2, 3, 4, 5],
              "mixed": [null, true, 3.14, "string", {"key": "value", "another": 42}]
            }
          }
        }
      }
    },
    "scientific": 0.000123,
