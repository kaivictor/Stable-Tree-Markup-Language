{
  "application": "MyApp",
  "version": "2.0.0",
  "description": "这是一个非常复杂的应用程序配置。\n它包含了数据库、服务器、日志、缓存、外部API、用户管理等多个模块。\n该配置文件用于演示YAML的丰富特性，包括多行字符串、锚点、别名、嵌套结构等。\n注意：此配置为示例，实际使用时请根据环境修改。\n",
  "database": {
    "host": "localhost",
    "port": 5432,
    "username": "admin",
    "password": "secret123",
    "database": "myapp_db",
    "pool_size": 10,
    "timeout": 30,
    "ssl": true,
    "options": {
      "connect_timeout": 5,
      "keepalives": 1,
      "keepalives_idle": 60
    }
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "ssl": {
      "enabled": true,
      "cert_file": "/etc/ssl/certs/myapp.crt",
      "key_file": "/etc/ssl/private/myapp.key"
    },
    "cors": {
      "allowed_origins": ["https://example.com", "https://app.example.com"],
      "allowed_methods": ["GET", "POST", "PUT", "DELETE"],
      "allowed_headers": ["Authorization", "Content-Type"]
    },
    "rate_limit": {
      "enabled": true,
      "requests_per_second": 100,
      "burst": 200
    }
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/myapp/app.log",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "handlers": [
      {
        "type": "file",
        "level": "INFO",
        "filename": "/var/log/myapp/app.log",
        "max_bytes": 10485760,
        "backup_count": 5
      },
      {
        "type": "console",
        "level": "DEBUG"
      },
      {
        "type": "syslog",
        "level": "ERROR",
        "address": "/dev/log"
      }
    ]
  },
  "cache": {
    "type": "redis",
    "host": "localhost",
    "port": 6379,
    "password": null,
    "db": 0,
    "ttl": 3600,
    "pool": {
      "max_connections": 50,
      "min_connections": 5,
      "timeout": 10
    }
  },
  "external_apis": [
    {
      "name": "PaymentGateway",
      "url": "https://api.payment.com/v1",
      "api_key": "pk_xxxxxxxxxxxx",
      "timeout": 30,
      "retry": {
        "max_retries": 3,
        "backoff_factor": 2
      },
      "endpoints": {
        "charge": "/charge",
        "refund": "/refund"
      }
    },
    {
      "name": "EmailService",
      "url": "https://api.emailservice.com/v2",
