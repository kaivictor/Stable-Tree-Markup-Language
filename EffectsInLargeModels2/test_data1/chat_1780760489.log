```stml
"这是一个": "非常丰富的STML文档示例"
"包含多种结构": "字符串、列表、字典、多行文本、注释、多文档等"
"作者": "AI助手"
"版本": "2.0.1"
"描述": {
本STML文档旨在展示STML格式的全部特性。
它包含多个文档，每个文档都有不同的结构。
注意：多行文本的右花括号必须与键的缩进对齐或更少。
这里的内容可以包含换行、空格、以及特殊字符如\"和\\，但需要转义。
例如：双引号\\\"和反斜杠\\\\。
}
"配置":
  "数据库":
    "主机": "localhost"
    "端口": "3306"
    "用户名": "admin"
    "密码": "secret123"
    "连接池":
      "最小连接数": "5"
      "最大连接数": "20"
      "超时时间": "30"
  "缓存":
    "类型": "redis"
    "地址": ["127.0.0.1:6379", "192.168.1.100:6379"]
    "密码": null
    "过期时间": "3600"
  "日志":
    "级别": "info"
    "输出": ["控制台", "文件"]
    "文件配置":
      "路径": "/var/log/app.log"
      "最大大小": "100MB"
      "备份数量": "5"
"用户列表":
  - "姓名": "张三"
    "年龄": "28"
    "邮箱": "zhangsan@example.com"
    "角色": "管理员"
    "权限": ["读取", "写入", "删除"]
  - "姓名": "李四"
    "年龄": "35"
    "邮箱": "lisi@example.com"
    "角色": "普通用户"
    "权限": ["读取"]
  - "姓名": "王五"
    "年龄": null
    "邮箱": "wangwu@example.com"
    "角色": "访客"
    "权限": []
"多行文本示例": {
第一行
第二行  保留空格
第三行包含特殊字符：\"和\\
最后一行
}
"嵌套字典测试":
  "第一层":
    "第二层":
      "第三层": "深层值"
    "另一个键": "值"
  "平级键": "平级值"
"列表内字典嵌套列表":
  - "名称": "项目A"
    "标签": ["重要", "紧急"]
    "描述": {
这是项目A的详细描述。
它包含多行文本。
}
  - "名称": "项目B"
    "标签": []
    "描述": "项目B没有多行描述"
"空值测试":
  "空字符串": ""
  "null值": null
  "空列表": []
  "空字典": {
}
"注释测试":
  "键1": "值1"
  "键2": "值2"
"行内列表测试": ["苹果", "香蕉", "橘子", "葡萄"]
"多行列表测试": ["第一项", "第二项", "第三项"]
"混合测试":
  "简单键": "简单值"
  "列表键": ["a", "b", "c"]
  "字典键":
    "子键1": "子值1"
    "子键2": "子值2"
  "多行键": "这是多行值"
---
"第二个文档": "开始第二个文档"
"文档编号": "2"
"内容": {
这个文档比较简单，用于演示多文档分隔。
注意：文档之间用三个短横线 --- 分隔。
}
"列表": ["元素1", "元素2", "元素3"]
"嵌套":
  "内层":
    "更深": "值"
---
"第三个文档": "最后一个文档"
"包含注释":
  "数据":
    "类型": "测试"
    "值": "123"
"多行文本": {
这是第三个文档的多行文本。
它包含换行。
}
"结束": "STML示例到此结束"
```