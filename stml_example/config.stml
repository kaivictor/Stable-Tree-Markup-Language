"应用名称": "STML演示"
"版本号": "1.0.0"
"服务端":
  "主机": "127.0.0.1"
  "端口": 8080
  "启用HTTPS": true
"数据库":
  "主机": "db.example.com"
  "端口": 5432
  "最大连接数": 100
  "超时秒数": 30
"功能开关":
  - "日志"
  - "缓存"
  - "通知"
"多行示例": {
这是一段多行文本。
支持任意字符，甚至 --- 和 ---。
直到独立的 } 结束。
}
"嵌套数据":
  "用户":
    "管理员":
      "名称": admin
      "权限":
        - 读取
        - 写入
        - 删除
    "访客":
      "名称": guest
      "权限":
        - 读取
